PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=gestion_formations

JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ── Assistant IA (résumés de formation/session, certificats, Q&A) ──────
# Défaut : IA LOCALE via Ollama — modèle Gemma 3 4B :
#   ollama serve  &&  ollama pull gemma3:4b
AI_PROVIDER=local
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=gemma3:4b
# Génération locale sur CPU : prévoir large (défaut du module ai : 180000 ms).
AI_TIMEOUT_MS=180000
# Budget du contexte RAG (extraits PDF) injecté dans le prompt, en caractères.
# 4800 par défaut : au-delà de ~4000 tokens (prompt + réponse), Ollama tronque le
# DÉBUT du prompt, ce qui fait perdre les consignes de rédaction.
AI_MAX_CONTEXT_CHARS=4800
# Pour analyser davantage d'extraits (rapports de 20+ pages), créer un variant à
# fenêtre plus large, puis monter le budget :
#   printf 'FROM gemma3:4b\nPARAMETER num_ctx 16384\n' > Modelfile
#   ollama create gemma3-steg -f Modelfile
#   → AI_MODEL=gemma3-steg  et  AI_MAX_CONTEXT_CHARS=18000

# Bascule vers l'API cloud : AI_PROVIDER=groq (la clé ci-dessous est alors utilisée)
GROQ_API_KEY=your_groq_api_key_here

# ── Envoi d'emails (SMTP) ─────────────────────────────────────────────
# Sans ces variables, les emails ne sont pas envoyés : ils sont seulement
# écrits dans les logs du serveur ([EMAIL LOG] ...).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
# Mot de passe d'application (16 caractères, sans espaces)
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_FROM=your.address@gmail.com
# URL du frontend, utilisée pour les liens des emails
FRONTEND_URL=http://localhost:8080
